# Local development settings, read by Docker Compose and by the Spring Boot application.
# Copy to .env and replace the placeholder passwords. Never commit .env.
# Use plain KEY=value lines: no quotes, no "export".

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chattywap
POSTGRES_USER=chattywap
POSTGRES_PASSWORD=change-me

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=chattywap
RABBITMQ_PASSWORD=change-me

# Signing key for access tokens: Base64, at least 32 bytes. Generate with: openssl rand -base64 32
# The placeholder is deliberately invalid, so the application won't start until you replace it.
JWT_SECRET=change-me
# Optional. Defaults shown.
# JWT_ISSUER=chattywap
# JWT_AUDIENCE=chattywap-api
# JWT_ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
