# Settings for a local load-test environment, read by Docker Compose and by the application.
# Copy to loadtest/.env (ignored by Git) and replace the placeholder passwords. Never point it at production.
#
# It uses its own Compose project (see loadtest/README.md), other ports and its own volumes, so the data of the
# normal development environment is never touched.

POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=chattywap_loadtest
POSTGRES_USER=chattywap
POSTGRES_PASSWORD=change-me

RABBITMQ_HOST=localhost
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=55673
RABBITMQ_USERNAME=chattywap
RABBITMQ_PASSWORD=change-me

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me
# Long enough that the tokens k6 gets in its setup outlive a test run.
JWT_ACCESS_TOKEN_TTL=2h

# Operational endpoints (health details, metrics) for the samplers in loadtest/sample-metrics.sh.
MANAGEMENT_PORT=8081
